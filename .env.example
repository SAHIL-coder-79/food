DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodshare
PORT=5000

# Generate a real secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10
NEAR_EXPIRY_THRESHOLD_MINUTES=60

# Rate limiting on POST /api/auth/login and POST /api/auth/register-organization (per client IP, in-memory,
# single-process). Leave blank to use the defaults below. See backend/src/middleware/rateLimiter.js.
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT_MAX=20
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000

# Deterministic Rescue Route Planning (POST /api/rescue-routes/preview) - a planning estimate only, not real
# navigation. Leave blank to use the defaults below. See backend/src/ai/rescueRoutePlanner.js.
RESCUE_ROUTE_MAX_STOPS=25
RESCUE_ROUTE_AVERAGE_SPEED_KMH=25
RESCUE_ROUTE_PICKUP_SERVICE_MINUTES=10
RESCUE_ROUTE_AT_RISK_BUFFER_MINUTES=30
RESCUE_ROUTE_URGENCY_TIE_BREAK_MINUTES=45

# WhatsApp/SMS rescue notification (POST /api/communications/rescue/:listingId/notify). Disabled by default -
# the app works fully with no external credentials. Only a deterministic mock provider exists today; see
# backend/src/integrations/communication/ and the "Communication" section of the root README.
COMMUNICATION_ENABLED=false
COMMUNICATION_PROVIDER=mock
COMMUNICATION_DEFAULT_CHANNEL=whatsapp
# Placeholders only - unused while COMMUNICATION_PROVIDER=mock; never commit real values.
COMMUNICATION_API_KEY=
COMMUNICATION_API_URL=
RESCUE_NOTIFICATION_MAX_RECIPIENTS=10
RESCUE_NOTIFICATION_COOLDOWN_MS=300000
COMMUNICATION_RATE_LIMIT_MAX=20
COMMUNICATION_RATE_LIMIT_WINDOW_MS=3600000

# Used by backend/scripts/seedSystemAdmin.js to bootstrap the first SYSTEM_ADMIN account.
# Leave blank until you are ready to run the seed script; never commit real values.
SYSTEM_ADMIN_NAME=
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=

# Optional: separate database for `npm test` so tests never touch dev data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodshare_test
