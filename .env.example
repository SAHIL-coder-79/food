DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodshare
PORT=5000

# Generate a real secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10
NEAR_EXPIRY_THRESHOLD_MINUTES=60

# Rate limiting on POST /api/auth/login and POST /api/auth/register-organization (per client IP, in-memory,
# single-process). Leave blank to use the defaults below. See backend/src/middleware/rateLimiter.js.
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT_MAX=20
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000

# Deterministic Rescue Route Planning (POST /api/rescue-routes/preview) - a planning estimate only, not real
# navigation. Leave blank to use the defaults below. See backend/src/ai/rescueRoutePlanner.js.
RESCUE_ROUTE_MAX_STOPS=25
RESCUE_ROUTE_AVERAGE_SPEED_KMH=25
RESCUE_ROUTE_PICKUP_SERVICE_MINUTES=10
RESCUE_ROUTE_AT_RISK_BUFFER_MINUTES=30
RESCUE_ROUTE_URGENCY_TIE_BREAK_MINUTES=45

# WhatsApp/SMS rescue notification (POST /api/communications/rescue/:listingId/notify). Disabled by default -
# the app works fully with no external credentials. Only a deterministic mock provider exists today; see
# backend/src/integrations/communication/ and the "Communication" section of the root README.
COMMUNICATION_ENABLED=false
COMMUNICATION_PROVIDER=mock
COMMUNICATION_DEFAULT_CHANNEL=whatsapp
# Placeholders only - unused while COMMUNICATION_PROVIDER=mock; never commit real values.
COMMUNICATION_API_KEY=
COMMUNICATION_API_URL=
RESCUE_NOTIFICATION_MAX_RECIPIENTS=10
RESCUE_NOTIFICATION_COOLDOWN_MS=300000
COMMUNICATION_RATE_LIMIT_MAX=20
COMMUNICATION_RATE_LIMIT_WINDOW_MS=3600000

# FoodShare Conversational Assistant (POST /api/messaging/webhook) - WhatsApp-ready, provider-agnostic.
# Disabled by default; the mock provider needs no credentials at all. See backend/src/integrations/messaging/
# and the "FoodShare Conversational Assistant" / "Real WhatsApp Integration" sections of the root README.
MESSAGING_ENABLED=false
MESSAGING_PROVIDER=mock
# Shared secret a webhook caller must present (mock provider only checks this when non-blank).
# A real provider would instead verify a cryptographic signature (e.g. Meta's X-Hub-Signature-256).
MESSAGING_WEBHOOK_SECRET=
MESSAGING_SESSION_TTL_MINUTES=10
MESSAGING_RATE_LIMIT_MAX=30
MESSAGING_RATE_LIMIT_WINDOW_MS=60000
# How long a WhatsApp identity-linking code (generated via POST /api/messaging/link-requests) stays valid.
MESSAGING_LINK_REQUEST_TTL_MINUTES=10

# Real Meta WhatsApp Cloud API - ONLY read/required when MESSAGING_PROVIDER=meta (see
# backend/src/integrations/messaging/metaProvider.js). Leave all of these blank while using the mock
# provider. NEVER commit real values here - this file only ever holds placeholders. Startup fails fast (does
# NOT silently fall back to mock) if MESSAGING_ENABLED=true and MESSAGING_PROVIDER=meta but any of these four
# required values below are missing.
# A value YOU choose; enter the SAME value into the Meta App Dashboard's webhook configuration.
META_WHATSAPP_VERIFY_TOKEN=
# From the Meta App Dashboard -> App Settings -> Basic -> App Secret.
META_WHATSAPP_APP_SECRET=
# A System User access token (or short-lived test token) for the WhatsApp Business Account.
META_WHATSAPP_ACCESS_TOKEN=
# From the Meta App Dashboard -> WhatsApp -> API Setup -> Phone number ID.
META_WHATSAPP_PHONE_NUMBER_ID=
# Verify the current version at https://developers.facebook.com/docs/graph-api/changelog before deploying -
# Meta deprecates old Graph API versions on a rolling schedule.
META_WHATSAPP_GRAPH_API_VERSION=v26.0

# LOCAL MOCK WHATSAPP INBOUND DEMO ONLY (POST /api/messaging/test/inbound) - never used in production, and
# never read by the real /api/messaging/webhook path. When set to an existing, active kitchen user's numeric
# id, the FIRST message from any unrecognised sender on the test endpoint is auto-linked to that user, so the
# full report -> confirm -> real-surplus-created flow can be demoed with zero manual identity linking. Leave
# blank to require the normal POST /api/messaging/link-requests flow even on the test endpoint. Not a real
# secret - just point it at a demo kitchen account's id from your own database.
TEST_MESSAGING_KITCHEN_USER_ID=

# Used by backend/scripts/seedSystemAdmin.js to bootstrap the first SYSTEM_ADMIN account.
# Leave blank until you are ready to run the seed script; never commit real values.
SYSTEM_ADMIN_NAME=
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=

# Optional: separate database for `npm test` so tests never touch dev data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/foodshare_test
